# 複製成同資料夾的 secrets.toml，填入你在 Google Cloud Console 建立的 OAuth 用戶端資料。
# Streamlit 電腦版與 FastAPI 手機版共用這個檔案。secrets.toml 含有密鑰，請勿分享或上傳。

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# 隨機長字串，用來簽署登入 cookie；可用 python -c "import secrets; print(secrets.token_urlsafe(32))" 產生
cookie_secret = "請換成隨機長字串"

[auth.google]
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
